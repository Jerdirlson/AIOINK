# Copiar a .env y ajustar. NUNCA commitear .env.

# Postgres local (coincide con docker-compose.yml)
DATABASE_URL="postgresql://iaoink:iaoink_dev@localhost:5433/iaoink?schema=public"

# Secreto para firmar los JWT. En produccion: valor aleatorio largo y unico.
# Generar uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="cambiar-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="7d"

PORT=3000
NODE_ENV=development
